# PC固有のもの。複数PCで同じリポジトリを共有するため、コミットしないこと。

# 音声デバイスIDはPCごとに異なるGUID。他PCへ持ち込むと存在しないIDになり、
# 保存先パスもユーザー名を含むため、設定ファイルは各PCのローカルに置く。
settings.json

# 明日の自分へメモのデータ。個人のメモなので共有しない。置き場自体は
# %LOCALAPPDATA%\traytools へ移してあるので、これは移行前の置き場に
# 残った場合の保険。
tomorrow_memo.json

# ショートカットは絶対パスを埋め込むので他PCでは壊れる(setup.py が作り直す)
*.lnk

__pycache__/
*.pyc

# あっふのアイコンは起動時にコードから生成される(icons/affx.ico)。
# 生成物なので追跡しない。
icons/affx.ico

# venv は %USERPROFILE%\.venvs\tray-tools に作る。中に作られた場合の保険。
venv/
.venv/

# ログはまとめて追跡しない。個人の使用履歴・PC固有の事象なので共有しない。
# (例外 error.log / クラッシュ crash.log / 操作 action.log / フック hooks/hook.log /
#  エージェントループ copilot_loop.log などが該当する)
#
# 【1つずつ名前で書かない理由】
# 以前は個別に並べていたが、この形だと**新しい名前のログが必ず漏れる**。実際、
# エージェントループが吐いた ai_session.log がコミット対象に入りかけた
# (2026-09-10)。public リポジトリなので事故になり得る。まとめて弾いておけば、
# 後から増えたログも黙って外れる。個別名を書かないほうが「何を隠しているか」も
# 漏れない。
*.log

# 設定ファイルの手動バックアップ。settings.json 自体と同じ理由で共有しない。
# 日時つきの settings.json.bak_20260823_111251 も拾えるよう末尾を * にする。
settings.json.bak*

# カンペ(画面ミラー)。中身は個人のものなので追跡しない。
# フォルダは mirror_notes が必要になった時点で作る(雛形もコード側が持っている)。
notes/

# 疑似エージェントループ(agent_loop.py)のキャンセルフラグと、実行用の一時 .ps1。
# ログ本体は上の *.log で拾える。
copilot_loop_scratch/
.copilot_loop_cancel

# 状態監視バーが覚えている位置とピン留め。PC・モニタ構成ごとの値なので共有しない。
copilot_status_state.json

# エージェントループの周回数を状態監視バーへ知らせるファイル。実行中だけ存在する。
copilot_loop_status.json

# 状態監視の子が「いまの手番」を常駐(進捗パネル)へ知らせるファイル。窓のハンドルを含むので公開しない。
copilot_turn_status.json

# ↑の書きかけ。os.replace で差し替える前の一時ファイル。
copilot_turn_status.json.tmp

# 「続けてよいか」への返事を子プロセスへ渡すファイル。聞いている間だけ存在する。
.copilot_loop_decision

# 応答とコードの全文ログ(何かあったとき掘る用)。*.log で既に外れるが、
# 何を書くファイルなのかを残しておく。世代退避で .log.1 も作る。
copilot_loop_responses.log*

# あっふ のスマホ送信のローカル CA(秘密鍵入り)。%LOCALAPPDATA%\traytools\phone_ca に作り、
# 作業ツリーには作らないが、うっかり持ち込んだときの保険。
phone_ca/
ca_key.pem

# LAN Drop が実行時に使う設定とアイコン。設定は端末ごとの値、アイコンは
# 実行時に置かれるものなので、どちらも追跡しない。
config.toml
landrop/static/icon.ico
